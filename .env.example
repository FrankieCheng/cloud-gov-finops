# Cloud Governance & FinOps Agent Configuration
# Mode: LIVE (real BigQuery Billing Export + Cloud Quotas/Compute/Monitoring) or MOCK (local fixtures)
GOV_API_MODE=LIVE
CHAT_ENGINE=llm
GOV_AGENT_MODEL=gemini-4-hydrogen

# Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=demo-core-prod
GOOGLE_CLOUD_LOCATION=global

# Cloud Governance Target Scope (Projects & Organization)
GOV_ORG_ID=123456789012
GOV_FOLDER_IDS=987654321098
GOV_PROJECTS=demo-core-prod,demo-edge-svc,demo-net-hub-a,demo-net-hub-b,demo-shared-dns
QUOTA_CRITICAL_THRESHOLD_PCT=90.0
QUOTA_WARNING_THRESHOLD_PCT=80.0

# FinOps BigQuery Detailed Billing Export
BILLING_BQ_PROJECT=demo-core-prod
BILLING_EXPORT_TABLES=demo-core-prod.billing.gcp_billing_export_resource_v1_01ABCD_EF0123_456789
BILLING_TIMEZONE=Asia/Shanghai
BILLING_TOP_N_ANOMALIES=5
BILLING_MIN_ANOMALY_DELTA_USD=1.0
BILLING_MIN_ANOMALY_PCT=20.0

# MSA Tracking Source (optional TSV/CSV seed path or Google Sheet export)
# MSA_SEED_TSV_PATH=

# New Feishu Bot (Cloud Governance & FinOps dedicated bot)
# Mounted from Secret Manager in production: FEISHU_GOV_APP_ID / FEISHU_GOV_APP_SECRET
# FEISHU_GOV_APP_ID=cli_xxxxxxxxxxxxxxxx
# FEISHU_GOV_APP_SECRET=
# FEISHU_GOV_NOTIFY_CHAT_IDS=
# FEISHU_GOV_ADMIN_OPEN_IDS=
# Optional Feishu custom group bot webhook fallback (strictly https://open.feishu.cn or https://open.larksuite.com)
# FEISHU_GOV_WEBHOOK_URL=
# FEISHU_GOV_WEBHOOK_SECRET=

# Scheduled Patrol Interval (seconds, 0 disables background push loop; e.g. 86400 for daily)
PATROL_INTERVAL_SECONDS=0
